<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <RadioGroup
            android:id="@+id/proxy_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/proxy_type_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/proxy_type_none" />

            <RadioButton
                android:id="@+id/proxy_type_socks5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/proxy_type_socks5" />

            <RadioButton
                android:id="@+id/proxy_type_http"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proxy_type_http" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/proxy_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/proxy_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_host"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />

            <EditText
                android:id="@+id/proxy_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_port"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5" />

            <EditText
                android:id="@+id/proxy_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_user"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1" />

            <EditText
                android:id="@+id/proxy_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_pass"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1" />
            <CheckBox
                android:id="@+id/proxy_remote_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proxy_remote_dns" />
        </LinearLayout>

        <TextView
            android:id="@+id/proxy_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
